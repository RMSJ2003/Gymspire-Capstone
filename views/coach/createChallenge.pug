extends ../base

block styles
  link(rel="stylesheet" href="/css/createChallenge.css")

block content

  //- ── NAVBAR ──────────────────────────────────────────
  nav.navbar
    .nav-logo
      a(href='/coachDashboard') GymSpire
    .nav-center
    .nav-right
      a.nav-back(href='javascript:history.back()')
        svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
          path(d='M19 12H5M5 12l7 7M5 12l7-7')
        span Back

  //- ── PAGE HEADER ─────────────────────────────────────
  .page-header
    .page-header__left
      if user.pfpUrl
        img.page-header__avatar(src=user.pfpUrl alt="Profile Picture" onerror="this.onerror=null;this.src='/img/default-user.png'")
      else
        img.page-header__avatar(src="/img/default-user.png" alt="Default Profile")
      div
        h1.page-header__title Create Challenge
        p.page-header__sub= user.username

  //- ── MAIN LAYOUT ─────────────────────────────────────
  .create-challenge-wrap

    //- Challenge details form (always visible, not hidden)
    .challenge-details-card
      .challenge-details-card__title
        svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
          path(d='M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7')
          path(d='M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z')
        span Challenge Details

      form#createChallengeForm.hidden
        .field-group
          label(for="name") Challenge Name
          input(type="text" name="name" id="name" placeholder="e.g. Push Day Blitz" required)

        .fields-row
          .field-group
            label(for="startTime") Start Time
            input(type="datetime-local" name="startTime" id="startTime" required)
          .field-group
            label(for="endTime") End Time
            input(type="datetime-local" name="endTime" id="endTime" required)

    //- Muscle group selector
    .muscles-section
      .muscles-section__label
        svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
          path(d='M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 5.57 4.14 4.14 2.71 2.71 4.14l1.43 1.43L2 7.71l1.43 1.43L2 10.57 3.43 12 7 8.43 15.57 17 12 20.57 13.43 22l1.43-1.43L16.29 22l2.14-2.14 1.43 1.43 1.43-1.43-1.43-1.43L22 16.29z')
        span Select exercises per muscle group

      .target-grid#targetGrid

    //- Submit
    .submit-row
      p.form-message#formMessage
      button.create-challenge-btn(type="submit" form="createChallengeForm")
        svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
          path(d='M12 5v14M5 12h14')
        | Create Challenge

  //- ── SPLIT-PANEL TARGET MODAL ────────────────────────
  .modal.hidden#targetModal
    .modal-content.large
      .modal-header
        h3#targetTitle
        .modal-header-right
          span.selected-count-badge#selectedCountBadge 0 selected
          button#closeTargetModal(type="button" aria-label="Close") ×

      .modal-split-body

        //- LEFT: live GIF preview
        .modal-preview-panel
          .preview-gif-wrap
            .preview-placeholder#previewPlaceholder
              svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5')
                path(stroke-linecap='round' stroke-linejoin='round' d='M5.25 5.25h2.25v13.5H5.25V5.25zm11.25 0h2.25v13.5H16.5V5.25zM8.25 9h7.5v6h-7.5V9z')
              span Hover an exercise
            img.preview-gif#previewGif(alt='Exercise preview')
          p.preview-name#previewName
          span.preview-badge#previewBadge

        //- RIGHT: exercise list
        .modal-list-panel
          .exercise-search-wrap
            svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
              circle(cx='11' cy='11' r='8')
              line(x1='21' y1='21' x2='16.65' y2='16.65')
            input#exerciseSearch(
              type='text'
              placeholder='Search exercises...'
              autocomplete='off'
            )
          .exercise-list#targetExerciseList

  //- ── DATA ────────────────────────────────────────────
  script#exercisesData(type="application/json").
    !{JSON.stringify(exercises)}

  script.
    window.exercises = JSON.parse(document.getElementById("exercisesData").textContent)

block scripts
  script(src="/js/createChallenge.js")
