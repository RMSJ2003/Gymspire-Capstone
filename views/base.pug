doctype html

html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no')
    title GymSpire | #{title}

    link(rel="stylesheet" href="/css/main.css")
    link(rel="stylesheet" href="/css/quote.css")

    link(rel="manifest" href="/manifest.json")
    meta(name="apple-mobile-web-app-capable" content="yes")
    meta(name="apple-mobile-web-app-status-bar-style" content="black-translucent")
    meta(name="apple-mobile-web-app-title" content="GymSpire")
    meta(name="theme-color" content="#d25353")
    link(rel="apple-touch-icon" href="/img/gymspirelogo.png")

    block styles

  body
    block content

    script(src='https://cdn.jsdelivr.net/npm/driver.js@1.0.1/dist/driver.js.iife.js')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/driver.js@1.0.1/dist/driver.css')
    script(src='/js/tutorial.js')

    block scripts
      script(src='/js/pwa.js')

    script.
      // ── BFCACHE GUARD ─────────────────────────────────────
      // Forces reload when browser restores from back-forward cache
      window.addEventListener("pageshow", function (e) {
        if (e.persisted) {
          window.location.reload();
        }
      });

      // ── HISTORY GUARD ─────────────────────────────────────
      // Replace login/signup in history so back button skips them
      (function () {
        const ref = document.referrer;
        if (ref.includes('/login') || ref.includes('/signup') || ref.includes('/onboarding')) {
          history.replaceState(null, '', window.location.href);
        }
      })();