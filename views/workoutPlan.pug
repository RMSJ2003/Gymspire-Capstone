extends base

block styles
  link(rel="stylesheet" href="/css/workoutPlan.css")

block content

  nav.navbar
    .nav-logo
      if user.userType === "user"
        a(href='/dashboard') GymSpire
      if user.userType === "coach"
        a(href='/coachDashboard') GymSpire
      if user.userType === "admin"
        a(href='/adminDashboard') GymSpire
    .nav-right
      a.nav-back(href='/dashboard')
        svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
          path(d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z')
          polyline(points='9 22 9 12 15 12 15 22')
        span Dashboard

  - const safeUser = user || { username: "Guest", pfpUrl: null }

  .page-header
    .page-header__left
      if safeUser.pfpUrl
        img.page-header__avatar(src=safeUser.pfpUrl alt="Profile Picture" onerror="this.onerror=null;this.src='/img/default-user.png'")
      else
        img.page-header__avatar(src="/img/default-user.png" alt="Default Profile")
      .page-header__text
        h1.page-header__title Workout Plan
        p.page-header__sub= safeUser.username
    .page-header__actions
      if gymPlan
        a.action-btn.action-btn--edit(href='/editWorkoutPlan?type=Gym')
          svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
            path(d='M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7')
            path(d='M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z')
          span Edit Gym Plan
      if !homePlan
        a.action-btn.action-btn--create(href='/createWorkoutPlan?skipToHome=true')
          svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
            line(x1='12' y1='5' x2='12' y2='19')
            line(x1='5' y1='12' x2='19' y2='12')
          span Add Home Plan
      if homePlan
        a.action-btn.action-btn--edit(href='/editWorkoutPlan?type=Home')
          svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
            path(d='M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7')
            path(d='M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z')
          span Edit Home Plan

  .plan-wrapper

    if !gymPlan
      .empty-state
        .empty-icon 📋
        p You don't have a workout plan yet.
        a.action-btn.action-btn--create(href='/createWorkoutPlan')
          svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
            line(x1='12' y1='5' x2='12' y2='19')
            line(x1='5' y1='12' x2='19' y2='12')
          span Create Workout Plan

    else

      .plan-tabs
        button.tab-btn.active#tabGym(onclick="switchTab('gym')") 🏋️ Gym Plan
        if homePlan
          button.tab-btn#tabHome(onclick="switchTab('home')") 🏠 Home Plan

      //- ── GYM PLAN TAB ──────────────────────────────────
      .tab-panel#panelGym

        if gymPlan.exerciseDetails && gymPlan.exerciseDetails.length
          .plan-stats
            span.plan-count
              strong= gymPlan.exerciseDetails.length
              |  exercise#{gymPlan.exerciseDetails.length !== 1 ? 's' : ''} in your Gym plan
          .exercises-grid
            each exercise in gymPlan.exerciseDetails
              .exercise-card
                if exercise.gifURL
                  img.exercise-gif(src=exercise.gifURL alt=exercise.name onerror="this.onerror=null;this.src='/img/default-user.png'")
                .exercise-body
                  .exercise-name= exercise.name || "Unnamed Exercise"
                  span.exercise-target= exercise.target || "N/A"
                  span.exercise-equipment= exercise.equipment
                  if exercise.instructions && exercise.instructions.length
                    button.steps-trigger(type='button') View Instructions
                    .steps-popup
                      .steps-popup__backdrop
                      .steps-popup__sheet
                        .steps-popup__head
                          span.steps-popup__title= exercise.name || "Instructions"
                          button.steps-popup__close(type='button') ×
                        if exercise.gifURL
                          img.steps-popup__gif(src=exercise.gifURL alt=exercise.name)
                        .steps-popup__meta
                          span.steps-popup__meta-label Equipment
                          span.steps-popup__meta-value= exercise.equipment
                        if exercise.target
                          .steps-popup__meta
                            span.steps-popup__meta-label Target Muscle
                            span.steps-popup__meta-value= exercise.target
                        ul.steps-popup__list
                          each step in exercise.instructions
                            li= step
        else
          .empty-state
            .empty-icon 🏋️
            p No exercises in your Gym plan yet.
            a.action-btn.action-btn--edit(href='/editWorkoutPlan?type=Gym')
              span Edit Gym Plan

      //- ── HOME PLAN TAB ─────────────────────────────────
      if homePlan
        .tab-panel.hidden#panelHome

          if homePlan.exerciseDetails && homePlan.exerciseDetails.length
            .plan-stats
              span.plan-count
                strong= homePlan.exerciseDetails.length
                |  exercise#{homePlan.exerciseDetails.length !== 1 ? 's' : ''} in your Home plan
            .exercises-grid
              each exercise in homePlan.exerciseDetails
                .exercise-card
                  if exercise.gifURL
                    img.exercise-gif(src=exercise.gifURL alt=exercise.name onerror="this.onerror=null;this.src='/img/default-user.png'")
                  .exercise-body
                    .exercise-name= exercise.name || "Unnamed Exercise"
                    span.exercise-target= exercise.target || "N/A"
                    span.exercise-equipment= exercise.equipment
                    if exercise.instructions && exercise.instructions.length
                      button.steps-trigger(type='button') View Instructions
                      .steps-popup
                        .steps-popup__backdrop
                        .steps-popup__sheet
                          .steps-popup__head
                            span.steps-popup__title= exercise.name || "Instructions"
                            button.steps-popup__close(type='button') ×
                          if exercise.gifURL
                            img.steps-popup__gif(src=exercise.gifURL alt=exercise.name)
                          .steps-popup__meta
                            span.steps-popup__meta-label Equipment
                            span.steps-popup__meta-value= exercise.equipment
                          if exercise.target
                            .steps-popup__meta
                              span.steps-popup__meta-label Target Muscle
                              span.steps-popup__meta-value= exercise.target
                          ul.steps-popup__list
                            each step in exercise.instructions
                              li= step
          else
            .empty-state
              .empty-icon 🏠
              p No exercises in your Home plan yet.
              a.action-btn.action-btn--edit(href='/editWorkoutPlan?type=Home')
                span Edit Home Plan

block scripts
  script.
    function switchTab(tab) {
      const panelGym  = document.getElementById('panelGym');
      const panelHome = document.getElementById('panelHome');
      const tabGym    = document.getElementById('tabGym');
      const tabHome   = document.getElementById('tabHome');

      if (tab === 'gym') {
        panelGym.classList.remove('hidden');
        if (panelHome) panelHome.classList.add('hidden');
        tabGym.classList.add('active');
        if (tabHome) tabHome.classList.remove('active');
      } else {
        panelGym.classList.add('hidden');
        if (panelHome) panelHome.classList.remove('hidden');
        tabGym.classList.remove('active');
        if (tabHome) tabHome.classList.add('active');
      }
    }

    (function () {
      document.querySelectorAll('.steps-trigger').forEach(function (btn) {
        var popup    = btn.nextElementSibling;
        var backdrop = popup.querySelector('.steps-popup__backdrop');
        var closeBtn = popup.querySelector('.steps-popup__close');
        function open()  { popup.classList.add('open'); document.body.style.overflow = 'hidden'; }
        function close() { popup.classList.remove('open'); document.body.style.overflow = ''; }
        btn.addEventListener('click', open);
        backdrop.addEventListener('click', close);
        closeBtn.addEventListener('click', close);
      });
    })();
  script.
    // If user came from createWorkoutPlan, replace it in history
    // so back button never returns there
    if (document.referrer.includes('/createWorkoutPlan')) {
      history.replaceState(null, '', '/workoutPlan');
    }