extends base

block styles
  link(rel="stylesheet" href="/css/workoutLogs.css")

block content

  nav.navbar
    .nav-logo
      if user.userType === "user"
        a(href='/dashboard') GymSpire
      if user.userType === "coach"
        a(href='/coachDashboard') GymSpire
      if user.userType === "admin"
        a(href='/adminDashboard') GymSpire
    .nav-right
      a.nav-back(href='javascript:history.back()')
        svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
          path(d='M19 12H5M5 12l7 7M5 12l7-7')
        span Back

  .page-header
    .page-header__left
      if user.pfpUrl
        img.page-header__avatar(src=user.pfpUrl alt="Profile Picture" onerror="this.onerror=null;this.src='/img/default-user.png'")
      else
        img.page-header__avatar(src="/img/default-user.png" alt="Default Profile")
      div
        h1.page-header__title= title
        p.page-header__sub= user.username
    a.pr-btn(href="/personalRecord")
      svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
        path(d='M12 20V10')
        path(d='M18 20V4')
        path(d='M6 20v-4')
      span My PR

  //- ── STATS BAR ───────────────────────────────────────────
  .stats-bar
    .stat-pill
      span.stat-num#totalCount= workoutLogs.length
      span.stat-label Total
    .stat-pill
      span.stat-num#soloCount= workoutLogs.filter(l => !l.challengeId).length
      span.stat-label Solo
    .stat-pill
      span.stat-num#challengeCount= workoutLogs.filter(l => l.challengeId).length
      span.stat-label Challenge
    .stat-pill
      span.stat-num#doneCount= workoutLogs.filter(l => l.status === 'done').length
      span.stat-label Completed

  //- ── FILTERS ─────────────────────────────────────────────
  .filters-bar
    .filter-group
      button.filter-btn.active(data-filter="all" data-group="type") All
      button.filter-btn(data-filter="solo" data-group="type") Solo
      button.filter-btn(data-filter="challenge" data-group="type") Challenge
    .filter-group
      button.filter-btn.active(data-filter="all" data-group="place") Any Place
      button.filter-btn(data-filter="gym" data-group="place") 🏋️ Gym
      button.filter-btn(data-filter="home" data-group="place") 🏠 Home
    .filter-group
      button.filter-btn.active(data-filter="all" data-group="status") All Status
      button.filter-btn(data-filter="done" data-group="status") ✓ Done
      button.filter-btn(data-filter="ongoing" data-group="status") ⏳ Ongoing
    .search-wrap
      input.search-input#dateSearch(type="date" title="Filter by date")
      button.search-clear#clearDate(type="button") ✕

  .filter-result-label#filterLabel

  //- ── LOGS ────────────────────────────────────────────────
  .logs-wrapper#logsWrapper

    if workoutLogs.length === 0
      .empty-state
        .empty-icon 🏋️
        p No workout logs yet. Start your first workout!

    else
      each log in workoutLogs
        - const isChallenge = !!log.challengeId
        - const place = log.place || 'gym'
        - const type = isChallenge ? 'challenge' : 'solo'
        - const dateStr = log.date.toISOString().split('T')[0]

        .log-card(
          data-type=type
          data-place=place
          data-status=log.status
          data-date=dateStr
        )
          .log-card__header
            .log-card__date
              svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
                rect(x='3' y='4' width='18' height='18' rx='2' ry='2')
                line(x1='16' y1='2' x2='16' y2='6')
                line(x1='8' y1='2' x2='8' y2='6')
                line(x1='3' y1='10' x2='21' y2='10')
              span= log.date.toDateString()
            .log-card__badges
              span.badge(class=log.status === "done" ? "badge--done" : "badge--pending")
                if log.status === "done"
                  | ✓ Done
                else
                  | ⏳ Ongoing
              if isChallenge
                span.badge.badge--challenge 🏆 Challenge
              else
                span.badge.badge--solo Solo
              span.badge(class=place === 'home' ? 'badge--home' : 'badge--gym')
                | #{place === 'home' ? '🏠 Home' : '🏋️ Gym'}

          //- Exercise preview chips
          if log.exercises && log.exercises.length
            .log-card__exercises
              each ex in log.exercises.slice(0, 4)
                span.ex-chip= ex.name
              if log.exercises.length > 4
                span.ex-chip.ex-chip--more +#{log.exercises.length - 4} more

          //- Challenge details
          if isChallenge
            .log-card__details
              .detail-row
                span.detail-label Strength Score
                span.detail-val= log.strengthScore > 0 ? log.strengthScore.toFixed(1) : "—"
              .detail-row
                span.detail-label Judge Status
                span.detail-val(class=log.judgeStatus === 'approved' ? 'val--approved' : log.judgeStatus === 'rejected' ? 'val--rejected' : '')
                  = log.judgeStatus || "Pending"
              if log.judgeNotes
                .detail-row
                  span.detail-label Judge Notes
                  span.detail-val= log.judgeNotes
              .detail-row
                span.detail-label Verified By
                span.detail-val= (log.verifiedBy && log.verifiedBy.username) || "Not verified yet"

          .log-card__actions
            a.view-btn(href=`/workoutLogs/${log._id}`)
              svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
                path(d='M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z')
                circle(cx='12' cy='12' r='3')
              | View Log

  //- ── NO RESULTS ──────────────────────────────────────────
  .empty-state.hidden#noResults
    .empty-icon 🔍
    p No logs match your filters.

  //- ── PAGINATION ──────────────────────────────────────────
  .pagination#pagination
    button.page-btn#prevBtn(type="button" disabled) ← Prev
    span.page-info#pageInfo
    button.page-btn#nextBtn(type="button") Next →

  p#finishMessage

block scripts
  script(src="/js/workoutLogs.js")