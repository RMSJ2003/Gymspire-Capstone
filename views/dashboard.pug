extends base

block styles
  link(rel="stylesheet" href="/css/dashboard.css")

block content

  nav.navbar
    .nav-logo
      if user.userType === "user"
        a.dashboard-btn(href='/dashboard') GymSpire
      if user.userType === "coach"
        a.dashboard-btn(href='/coachDashboard') GymSpire
      if user.userType === "admin"
        a.dashboard-btn(href='/adminDashboard') GymSpire
      if user.userType === "clinic"
        a.dashboard-btn(href='/clinicDashboard') GymSpire
    .nav-center
    .nav-right
      button.hamburger ☰
      .panel
        a(href="/profile") Profile
        form(action="/api/v1/auth/logout" method="GET")
          button(type="submit") Logout

  .quote-banner
    .quote-banner__inner
      span.quote-banner__text#quoteBannerText

  .dash-header
    .dash-header__left
      img.dash-logo(src="/img/gymspirelogo.png" alt="GymSpire Logo" onerror="this.onerror=null;this.src='/img/default-user.png'")
      h2.dash-title Welcome, #{user.username}
    .dash-header__right
      span.dash-week-label Workouts this week:
      if workoutCount === 0
        strong.dash-week-val No workout yet
      else
        strong.dash-week-val #{workoutCount}

  //- ── PROFILE SUGGESTION CARD ─────────────────────────
  if profileSuggestion && profileSuggestion.hasProfile
    .suggestion-card
      .suggestion-card-header
        .suggestion-card-title
          span.suggestion-icon 🎯
          strong Today's Recommendation
        span.suggestion-goal-badge= profileSuggestion.goalLabel
      .suggestion-body
        .suggestion-row
          .suggestion-item
            span.suggestion-item-label 💪 Focus
            span.suggestion-item-val
              each muscle, i in profileSuggestion.suggestedMuscles
                span.muscle-tag= muscle
                if i < profileSuggestion.suggestedMuscles.length - 1
                  |  
          .suggestion-item
            span.suggestion-item-label ⚡ Intensity
            - const intensityColor = profileSuggestion.intensity === 'hard' ? '#dc2626' : profileSuggestion.intensity === 'easy' ? '#16a34a' : '#d97706'
            span.suggestion-item-val(style=`color: ${intensityColor}`)= profileSuggestion.intensity.charAt(0).toUpperCase() + profileSuggestion.intensity.slice(1)
          .suggestion-item
            span.suggestion-item-label 🎓 Level
            span.suggestion-item-val= profileSuggestion.experience.charAt(0).toUpperCase() + profileSuggestion.experience.slice(1)
      p.suggestion-note Based on your fitness profile. Update anytime in #[a(href="/editProfile") Edit Profile].

  //- ── ONGOING WORKOUT RESUME BANNER ──────────────────
  if ongoingLog
    .ongoing-banner
      .ongoing-banner__icon 🏋️
      .ongoing-banner__body
        strong You have an unfinished workout
        p Started #{ongoingLog.workoutType} workout — #{ongoingLog.exercises ? ongoingLog.exercises.length : 0} exercise(s)
      a.ongoing-banner__btn(href=`/workoutLogs/${ongoingLog._id}`) Resume →
  .status-exercise-grid

    .status-card
      p
        if recommended
          strong Recommended to workout now
        else
          strong Not recommended to workout now
      p #{message}
      p
        | Active GymSpire Sessions:&nbsp;
        data(value=currentLoad) #{currentLoad}

      //- ── GYM HOURS TODAY ─────────────────────────────
      if todaySchedule
        .gym-today-hours
          svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
            circle(cx='12' cy='12' r='10')
            polyline(points='12 6 12 12 16 14')
          if todaySchedule.isOpen
            span Today (#{todaySchedule.day}):&nbsp;
            strong #{formatHour12(todaySchedule.openingHour)} — #{formatHour12(todaySchedule.closingHour)}
          else
            span.gym-closed Today (#{todaySchedule.day}): Closed

      //- ── WEEKLY SCHEDULE TOGGLE ──────────────────────
      button.gym-schedule-toggle#gymScheduleToggle(type='button') View Weekly Schedule ▾
      .gym-schedule-table.hidden#gymScheduleTable
        each day in gymSchedule
          .gym-schedule-row(class=day.isOpen ? '' : 'gym-schedule-row--closed')
            span.gym-schedule-day= day.day.slice(0,3)
            if day.isOpen
              span.gym-schedule-hours= formatHour12(day.openingHour) + ' — ' + formatHour12(day.closingHour)
            else
              span.gym-schedule-closed Closed

    .status-card.checkin-card
      h3 Currently Working Out

      button.checkin-btn#checkinBtn(
        data-gym-status=user.gymStatus
        data-checkin-time=user.gymCheckinTime ? user.gymCheckinTime.toISOString() : ''
        data-is-at-gym=user.isAtGym ? 'true' : 'false'
      )
        svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
          path(d='M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z')
        span#checkinBtnText I'm at the gym

      .workout-prompt#workoutPrompt
        svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
          path(d='M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z')
        | You're checked in! Want to log your session?&nbsp;
        a(href='/startSoloWorkout') Start Workout →

      .card-divider

      if onlineUsers.length === 0
        p.empty-state No one is currently working out.
      else
        .online-users-wrap
          .online-users#onlineUsersList
            each u in onlineUsers
              .online-user
                if u.pfpUrl
                  img(src=u.pfpUrl alt=u.username width='32' height='32' onerror="this.onerror=null;this.src='/img/default-user.png'")
                else
                  img(src='/img/default-user.png' alt=u.username width='32' height='32' onerror="this.onerror=null;this.src='/img/default-user.png'")
                span= u.username
                if u.gymStatus === 'logging' && u.isAtGym
                  span.user-badge.badge-workout Logging
                  span.user-badge.badge-atgym At Gym
                else if u.gymStatus === 'logging'
                  span.user-badge.badge-workout Logging
                else if u.gymStatus === 'atGym'
                  span.user-badge.badge-atgym At Gym
          .users-pagination
            span.users-page-info#usersPageInfo
            .users-page-btns
              button.users-page-btn#usersPrev(type='button' disabled) ‹
              button.users-page-btn#usersNext(type='button') ›

      p.attendance-logged#attendanceLogged
        | ✓ Attendance recorded at 
        span#checkinTime
      .checkout-row#checkoutRow
        button.checkout-link#checkoutBtn Leave gym / Check out

    .exercise-log-card
      h3 Targeted Muscles This Week
      if frequencies.length === 0
        p No workout data available for this week.
      else
        - const trainedItems = frequencies.filter(i => i.trained > 0)
        if trainedItems.length === 0
          p.muscles-empty All caught up — no muscles trained yet this week.
        ul.exercise-list
          each item in frequencies
            - const isDone = item.trained >= item.target
            - const isUntrained = item.trained === 0
            li(class=isUntrained ? 'untrained' : '')
              span.muscle-name #{item.muscle}:
              span(class='muscle-count' + (isDone ? ' done' : '')) #{item.trained} / #{item.target}

  .dashboard(data-type="user")
    - const cards = ["Challenges", "Workout Plan", "Workout Logs", "Solo Workout"];
    each item, index in cards
      .card
        .card-inner
          h3 #{item === 'Solo Workout' ? 'Start Workout' : item}
          .card-actions
            - let url = '/' + item.toLowerCase().replaceAll(' ', '-');
            a.card-link(href=url) #{item}
            button.info-btn(data-index=index title="More Info") i

  .congestion-panel
    .congestion-panel__head
      .congestion-panel__title
        svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
          path(d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2')
          circle(cx='9' cy='7' r='4')
          path(d='M23 21v-2a4 4 0 0 0-3-3.87')
          path(d='M16 3.13a4 4 0 0 1 0 7.75')
        span Gym Congestion
      .congestion-panel__meta
        span.congestion-live-badge#congestionLive

    .congestion-loading#loadingState
      .cong-spinner
      span Analyzing attendance data...

    .congestion-body.hidden#contentWrap

      .congestion-col-chart
        .congestion-section-label
          svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
            circle(cx='12' cy='12' r='10')
            polyline(points='12 6 12 12 16 14')
          span Today's predicted busyness
        .hour-chart#hourChart

      .congestion-col-side
        .congestion-rec#recommendationCard
          .congestion-rec__label Your best time to visit
          .congestion-rec__time#recTime —
          .congestion-rec__sub#recSub Loading...

        .congestion-section-label.congestion-section-label--side
          svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
            rect(x='3' y='4' width='18' height='18' rx='2' ry='2')
            line(x1='16' y1='2' x2='16' y2='6')
            line(x1='8' y1='2' x2='8' y2='6')
            line(x1='3' y1='10' x2='21' y2='10')
          span Quietest days this week
        .day-chart#dayChart

        .congestion-stats
          .cong-stat
            span.cong-stat__val#peakTime —
            span.cong-stat__label Busiest Hour
          .cong-stat
            span.cong-stat__val#quietDay —
            span.cong-stat__label Quietest Day
          .cong-stat
            span.cong-stat__val#totalRecords —
            span.cong-stat__label Check-ins

        .cong-low-data.hidden#lowDataBanner
          span ⚠️ Limited data — predictions improve as more members check in.

  .modal.hidden#modal
    .modal-content
      button#closeModal ×
      p#modalText

  script.
    document.getElementById('gymScheduleToggle').addEventListener('click', function() {
      const table = document.getElementById('gymScheduleTable');
      const isHidden = table.classList.contains('hidden');
      table.classList.toggle('hidden', !isHidden);
      this.textContent = isHidden ? 'Hide Schedule ▴' : 'View Weekly Schedule ▾';
    });
  script(src="/js/dashboard.js")
  script(src="/js/quoteBanner.js")
  script(src="/js/gymCheckin.js")
  script(src="/js/onlineUsersPagination.js")
  script(src="/js/congestion.js")