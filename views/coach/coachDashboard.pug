extends ../base

block styles
  link(rel="stylesheet" href="/css/dashboard.css")
  link(rel="stylesheet" href="/css/coachDashboard.css")

block content

  //- ── NAVBAR ──────────────────────────────────────────
  nav.navbar
    .nav-logo
      a(href='/coachDashboard') GymSpire
    .nav-center
    .nav-right
      button.hamburger ☰
      .panel
        a(href="/profile") Profile
        form(action="/api/v1/auth/logout" method="GET")
          button(type="submit") Logout

  //- ── QUOTE BANNER ────────────────────────────────────
  .quote-banner
    .quote-banner__inner
      span.quote-banner__text#quoteBannerText

  //- ── COMPACT HEADER ──────────────────────────────────
  .dash-header
    .dash-header__left
      img.dash-logo(src="/img/gymspirelogo.png" alt="GymSpire Logo" onerror="this.onerror=null;this.src='/img/default-user.png'")
      h2.dash-title Welcome, #{user.username}
    .dash-header__right
      span.dash-week-label Active Sessions:
      strong.dash-week-val= currentLoad

  //- ── COACH MAIN GRID ─────────────────────────────────
  //- Left: action cards + status
  //- Right: member fatigue table
  //- NOTE: No check-in — coaches are not gym members
  .coach-main-grid

    //- ── LEFT COLUMN ─────────────────────────────────
    .coach-left

      .coach-card
        h3.coach-card__title Challenges
        .coach-card__actions
          a.card-link(href='/challenges') Challenges
          button.info-btn(data-index='0' title='More Info') i

      .status-card.compact
        p
          if recommended
            strong.status-good ✓ Good time to train
          else
            strong.status-bad ✗ Gym is busy
        p.status-msg #{message}

      .status-card.compact
        h3 Currently Working Out
        if onlineUsers.length === 0
          p.empty-state No active sessions right now.
        else
          .online-users
            each u in onlineUsers
              .online-user
                if u.pfpUrl
                  img(src=u.pfpUrl alt=u.username width='32' height='32' onerror="this.onerror=null;this.src='/img/default-user.png'")
                else
                  img(src='/img/default-user.png' alt=u.username width='32' height='32' onerror="this.onerror=null;this.src='/img/default-user.png'")
                span= u.username
                if u.gymStatus === 'logging' && u.isAtGym
                  span.user-badge.badge-workout Logging
                  span.user-badge.badge-atgym At Gym
                else if u.gymStatus === 'logging'
                  span.user-badge.badge-workout Logging
                else if u.gymStatus === 'atGym'
                  span.user-badge.badge-atgym At Gym

    //- ── RIGHT COLUMN — Fatigue Table ─────────────────
    .coach-right
      .coach-fatigue-section
        .fatigue-header
          h3.fatigue-title
            svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
              path(d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2')
              circle(cx='9' cy='7' r='4')
              path(d='M23 21v-2a4 4 0 0 0-3-3.87')
              path(d='M16 3.13a4 4 0 0 1 0 7.75')
            span Member Progress Overview
          p.fatigue-sub Live snapshot of all members' activity &amp; fatigue trends

        .fatigue-table-wrap
          table.fatigue-table
            thead
              tr
                th Member
                th Last Session
                th Trend
                th Status
            tbody#fatigueTbody
              tr.fatigue-loading
                td(colspan='4')
                  span.fatigue-spinner
                  | &nbsp;Loading…

  //- ── INLINE GYM CONGESTION PANEL ────────────────────
  //- Same element IDs as congestion.js — no JS changes needed
  .congestion-panel
    .congestion-panel__head
      .congestion-panel__title
        svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
          path(d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2')
          circle(cx='9' cy='7' r='4')
          path(d='M23 21v-2a4 4 0 0 0-3-3.87')
          path(d='M16 3.13a4 4 0 0 1 0 7.75')
        span Gym Congestion
      .congestion-panel__meta
        span.congestion-live-badge#congestionLive
        a.congestion-full-link(href='/congestion') Full view →

    .congestion-loading#loadingState
      .cong-spinner
      span Analyzing attendance data...

    .congestion-body.hidden#contentWrap

      .congestion-col-chart
        .congestion-section-label
          svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
            circle(cx='12' cy='12' r='10')
            polyline(points='12 6 12 12 16 14')
          span Today's predicted busyness
        .hour-chart#hourChart

      .congestion-col-side
        .congestion-rec#recommendationCard
          .congestion-rec__label Your best time to visit
          .congestion-rec__time#recTime —
          .congestion-rec__sub#recSub Loading...

        .congestion-section-label.congestion-section-label--side
          svg(xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24')
            rect(x='3' y='4' width='18' height='18' rx='2' ry='2')
            line(x1='16' y1='2' x2='16' y2='6')
            line(x1='8' y1='2' x2='8' y2='6')
            line(x1='3' y1='10' x2='21' y2='10')
          span Quietest days this week
        .day-chart#dayChart

        .congestion-stats
          .cong-stat
            span.cong-stat__val#peakTime —
            span.cong-stat__label Busiest Hour
          .cong-stat
            span.cong-stat__val#quietDay —
            span.cong-stat__label Quietest Day
          .cong-stat
            span.cong-stat__val#totalRecords —
            span.cong-stat__label Check-ins

        .cong-low-data.hidden#lowDataBanner
          span ⚠️ Limited data — predictions improve as more members check in.

  //- Hidden .dashboard needed for dashboard.js type detection
  .dashboard(data-type='coach' style='display:none')

  .modal.hidden#modal
    .modal-content
      button#closeModal ×
      p#modalText

  script(src='/js/dashboard.js')
  script(src='/js/quoteBanner.js')
  script(src='/js/coachFatigue.js')
  script(src='/js/congestion.js')
